{
  "name": "kbj-nestjs-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --debug --watch",
    "start": "node dist/src/main",
    "build": "nest build",
    "docker-build": "docker build -f ./ci/Dockerfile --tag kbj-nestjs-backend:1.0 .",
    "test": "jest --detectOpenHandles --runInBand --verbose --forceExit",
    "test:coverage": "jest --detectOpenHandles --runInBand --verbose --forceExit --coverage",
    "format": "prettier --write .",
    "db-up": "docker-compose -f ./infra/docker-compose.yaml up -d",
    "db-down": "docker-compose -f ./infra/docker-compose.yaml down",
    "======MIGRATION=======": "=======================================================",
    "typeorm": "ts-node ./src/config/system-warn.config.ts && sleep 5 && ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource ./src/config/system-migration.config.ts",
    "migration:generate:kbj": "npm run migration:apply:kbj && MIGRATION_PATH=kbj npm run typeorm migration:generate ./src/repositories/migrations/kbj/Migration",
    "migration:show:kbj": "MIGRATION_PATH=kbj npm run typeorm migration:show",
    "migration:apply:kbj": "MIGRATION_PATH=kbj npm run typeorm migration:run",
    "migration:revert:kbj": "MIGRATION_PATH=kbj npm run typeorm migration:revert"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.914.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@slack/web-api": "^7.11.0",
    "@supercharge/request-ip": "^1.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "mysql2": "^3.15.3",
    "passport-jwt": "^4.0.1",
    "randomstring": "^1.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.9.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/randomstring": "^1.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
